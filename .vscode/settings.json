    "rust-analyzer.check.command": "clippy",
    "coverage-gutters.coverageFileNames": [
        "coverage/tests.lcov",
    ],
    "cSpell.words": [
        "Addrs",
        "chacha",
        "clippy",
        "combinators",
        "dtolnay",
        "flate",
        "grcov",
        "idents",
        "keystream",
        "lcov",
        "MSRV",
        "multilib",
        "rustc",
        "rustdoc",
        "RUSTDOCFLAGS",
        "rustfmt",
        "rustup",
        "serde",
        "struct",
        "thiserror",
        "wincode",
        "zstd"
